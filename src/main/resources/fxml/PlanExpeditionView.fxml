<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="oskar.rojek.s25723.masproject.controller.PlanExpeditionController"
      prefHeight="400.0" prefWidth="600.0" spacing="20" alignment="TOP_CENTER" >

    <padding>
        <Insets top="20"/>
    </padding>

    <VBox spacing="10" alignment="CENTER">
        <Label text="Planowanie Ekspedycji" style="-fx-font-size: 30px; -fx-font-weight: bold;"/>
        <HBox alignment="CENTER" spacing="10">
            <Label fx:id="ruinChoiceLabel" text="Wybór ruin" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
            <Label fx:id="dataFillLabel" text="Uzupełnienie danych" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: gray;"/>
            <Label fx:id="teamChoiceLabel" text="Wybór drużyny" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: gray;"/>
            <Label fx:id="summaryLabel" text="Podsumowanie" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: gray;"/>
        </HBox>
    </VBox>

    <VBox fx:id="mainContainer" spacing="20" alignment="CENTER">
        <HBox spacing="40" alignment="CENTER">
            <VBox spacing="5" alignment="CENTER">
                <Label text="Krainy" style="-fx-font-size: 30px; -fx-font-weight: bold;"/>
                <TableView fx:id="realmTable" maxWidth="302" maxHeight="300">
                    <columns>
                        <TableColumn fx:id="realmNameColumn" text="Nazwa" prefWidth="180"/>
                        <TableColumn fx:id="realmElementColumn" text="Dominujący Żywioł" prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>
            <VBox fx:id="realmDetailsVBox" visible="false" spacing="10">
                <VBox>
                    <Label text="Szczegóły krainy" style="-fx-font-size: 25px; -fx-font-weight: bold;"/>
                    <Label fx:id="realmName" text="Nazwa: " style="-fx-font-size: 15px;"/>
                    <Label fx:id="realmElement" text="Dominujący żywioł: " style="-fx-font-size: 15px;"/>
                    <Label fx:id="realmSize" text="Wielkość: " style="-fx-font-size: 15px;"/>
                    <Label fx:id="realmPopulation" text="Populacja: " style="-fx-font-size: 15px;"/>
                </VBox>

                <Label text="Ruiny" style="-fx-font-size: 25px; -fx-font-weight: bold;"/>
                <TableView fx:id="ruinTable" maxWidth="400" minHeight="200">
                    <columns>
                        <TableColumn fx:id="ruinNameColumn" text="Nazwa" prefWidth="130"/>
                        <TableColumn fx:id="ruinDifficultyColumn" text="Poziom Trudności" prefWidth="110"/>
                        <TableColumn fx:id="ruinRequiredPowerColumn" text="Wymagana Moc" prefWidth="110"/>
                    </columns>
                </TableView>
                <HBox alignment="CENTER" spacing="10">
                    <Button text="Dalej" alignment="CENTER" onAction="#continueToForm" />
                </HBox>
            </VBox>

        </HBox>

        <VBox fx:id="formView"  spacing="20" visible="false">
            <padding>
                <Insets top="30"/>
            </padding>
            <VBox alignment="CENTER">
                <HBox spacing="10" alignment="CENTER">
                    <Label text="Nazwa Ekspedycji:" style="-fx-font-size: 15px;"/>
                    <TextField fx:id="expeditionNameTextField" promptText="Nazwa Ekspedycji (min. 2 znaki)"/>
                </HBox>
                <Label fx:id="nameError" text="Nazwa ekspedycji jest niepoprawna" style="-fx-font-size: 10px; -fx-text-fill: red;" visible="false"/>
            </VBox>
            <VBox alignment="CENTER">
                <HBox spacing="10" alignment="CENTER">
                    <Label text="Data rozpoczęcia:" style="-fx-font-size: 15px;"/>
                    <DatePicker fx:id="expeditionStartDateDatePicker"/>
                </HBox>
                <Label fx:id="dateError" text="Data jest wymagana" style="-fx-font-size: 10px; -fx-text-fill: red;" visible="false"/>
            </VBox>

            <HBox alignment="CENTER" spacing="10">
                <Button text="Dalej" alignment="CENTER" onAction="#continueToTeamChoice" />
            </HBox>
        </VBox>

        <VBox fx:id="teamChoiceView" spacing="20" alignment="CENTER" visible="false">
            <HBox spacing="40" alignment="CENTER">
                <VBox spacing="5" alignment="CENTER">
                    <Label text="Dostępni odkrywcy" style="-fx-font-size: 30px; -fx-font-weight: bold;"/>
                    <TableView fx:id="availableExplorerTable" maxWidth="302" maxHeight="300">
                        <columns>
                            <TableColumn fx:id="explorerNameColumn" text="Nazwa" prefWidth="180"/>
                            <TableColumn fx:id="explorerPowerColumn" text="Poziom Mocy" prefWidth="120"/>
                        </columns>
                    </TableView>
                    <HBox alignment="CENTER" spacing="10">
                        <Button text="Dodaj" alignment="CENTER" onAction="#addToTeam" />
                        <Button text="Dodaj nowego odkrywcę" alignment="CENTER" onAction="#showNextUseCasePopup" />
                    </HBox>
                </VBox>

                <VBox spacing="5" alignment="CENTER">
                    <Label text="Drużyna" style="-fx-font-size: 30px; -fx-font-weight: bold;"/>
                    <TableView fx:id="teamTable" maxWidth="302" maxHeight="300">
                        <columns>
                            <TableColumn fx:id="explorerInTeamNameColumn" text="Nazwa" prefWidth="180"/>
                            <TableColumn fx:id="explorerInTeamPowerColumn" text="Poziom Mocy" prefWidth="120"/>
                        </columns>
                    </TableView>
                    <HBox alignment="CENTER" spacing="10">
                        <Label fx:id="powerLabel" text="wymagana moc: " style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
                        <Button text="Usuń" alignment="CENTER" onAction="#removeFromTeam" />
                    </HBox>
                </VBox>
            </HBox>
            <HBox alignment="CENTER" spacing="10">
                <Button text="Dalej" alignment="CENTER" onAction="#continueToSummary" />
            </HBox>
        </VBox>

        <VBox fx:id="summaryView" spacing="10" alignment="CENTER" visible="false">
            <VBox alignment="CENTER">
                <Label fx:id="expeditionNameSummaryLabel" text="Nazwa Ekspedycji: " style="-fx-font-size: 15px;"/>
                <Label fx:id="realmNameSummaryLabel" text="Kraina: " style="-fx-font-size: 15px;"/>
                <Label fx:id="ruinNameSummaryLabel" text="Ruina: " style="-fx-font-size: 15px;"/>
                <Label fx:id="startDateSummaryLabel" text="Data Rozpoczęcia: " style="-fx-font-size: 15px;"/>
                <Label fx:id="powerSummaryLabel" text="Moc: " style="-fx-font-size: 15px;"/>
            </VBox>
            <VBox spacing="10" alignment="CENTER" >
                <Label text="Drużyna" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                <TableView fx:id="teamTableSummary" maxWidth="302" maxHeight="200">
                    <columns>
                        <TableColumn fx:id="explorerNameSummaryColumn" text="Nazwa" prefWidth="180"/>
                        <TableColumn fx:id="explorerPowerSummaryColumn" text="Poziom Mocy" prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>
            <HBox alignment="CENTER" spacing="10">
                <Button text="Zatwierdź" alignment="CENTER" onAction="#finishPlanning" />
            </HBox>
        </VBox>
    </VBox>
</VBox>
